{
  "name": "xgboost-predictor",
  "version": "1.0.0-rc.1",
  "description": "Zero-dependency XGBoost inference for browser, edge, and Node runtimes.",
  "license": "MIT",
  "author": "Anirudh Mazumder",
  "keywords": [
    "xgboost",
    "inference",
    "predictor",
    "gradient-boosting",
    "zero-dependency",
    "edge"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:nobuild": "node --test test/*.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "rc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anirudhmazumder/xgboost-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/anirudhmazumder/xgboost-bridge/issues"
  },
  "homepage": "https://github.com/anirudhmazumder/xgboost-bridge#readme"
}
